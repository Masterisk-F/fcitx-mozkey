load("//:build_defs.bzl", "MOZC_TAGS", "mozc_cc_binary", "mozc_cc_test", "mozc_cc_library")

package(default_visibility = ["//visibility:private"])

mozc_cc_binary(
    name = "mozc_zenz_scorer",
    srcs = [
        "main.cc",
    ],
    linkopts = select({
        "@platforms//os:windows": [
            "Advapi32.lib",
            "Bcrypt.lib",
            "Winhttp.lib",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)

mozc_cc_test(
    name = "scorer_signal_test",
    srcs = ["scorer_signal_test.cc"],
    data = [":mozc_zenz_scorer"],
    deps = [
        "//testing:gunit_main",
    ],
)
